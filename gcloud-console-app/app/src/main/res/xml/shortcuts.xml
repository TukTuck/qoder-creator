            android:targetClass="app.consolepocket.MainActivity"
            android:targetPackage="app.consolepocket">
            <extra
                android:name="app.consolepocket.extra.URL"
                android:value="https://console.cloud.google.com/billing" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_logs"
