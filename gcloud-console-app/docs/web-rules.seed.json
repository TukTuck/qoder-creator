{
  "$comment": "SEED-Regelwerk fuer die RequestPipeline (M3). ALLE Muster sind Kandidaten und muessen am echten Traffic mit chrome://inspect verifiziert werden, bevor sie im Modus ENFORCE verwendet werden. Startmodus: LOG_ONLY.",
  "version": 1,
  "mode": "LOG_ONLY",
  "defaults": {
    "policy": "IGNORE",
    "cacheMaxBytes": 268435456,
    "immutableTtlDays": 30,
    "swrTtlDays": 7,
    "connectTimeoutSeconds": 5,
    "readTimeoutSeconds": 15
  },
  "neverIntercept": {
    "$comment": "Harte Ausschluesse: niemals cachen/blocken, sonst bricht Auth oder Datenfrische.",
    "methods": [
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "mainFrame": true,
    "hostPatterns": [
      "accounts.google.com",
      "apis.google.com",
      "*.googleapis.com"
    ],
    "pathPatterns": [
      "**/_/signin**",
      "**/batchexecute**",
      "**/o/oauth2/**",
      "/m/_/Diagnostics**"
    ]
  },
  "rules": [
    {
      "id": "block-telemetry-play-log",
      "enabled": true,
      "priority": 100,
      "match": {
        "hostPatterns": [
          "play.google.com"
        ],
        "pathPatterns": [
          "/log**"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      },
      "note": "Logging-Beacon, kein Nutzwert"
    },
    {
      "id": "block-clientmetrics",
      "enabled": true,
      "priority": 100,
      "match": {
        "hostPatterns": [
          "*.google.com",
          "*.gstatic.com"
        ],
        "queryContains": [
          "clientmetrics"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      }
    },
    {
      "id": "block-csi",
      "enabled": true,
      "priority": 100,
      "match": {
        "pathPatterns": [
          "**/csi**",
          "**/gen_204**"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      },
      "note": "Client Speed Indicators / Tracking-Pixel"
    },
    {
      "id": "block-firelog",
      "enabled": true,
      "priority": 100,
      "match": {
        "hostPatterns": [
          "firebaselogging*.googleapis.com",
          "play.googleapis.com"
        ],
        "pathPatterns": [
          "**/log**"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      }
    },
    {
      "id": "block-gtm-analytics",
      "enabled": true,
      "priority": 95,
      "match": {
        "hostPatterns": [
          "www.googletagmanager.com",
          "www.google-analytics.com",
          "ssl.google-analytics.com",
          "region1.google-analytics.com"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      }
    },
    {
      "id": "block-feedback-survey",
      "enabled": false,
      "priority": 90,
      "match": {
        "hostPatterns": [
          "*.google.com"
        ],
        "pathPatterns": [
          "**/scone**",
          "**/survey**",
          "**/feedback**"
        ]
      },
      "policy": "BLOCK",
      "response": {
        "status": 204
      },
      "note": "default AUS: erst in LOG_ONLY pruefen, ob die Console davon abhaengt"
    },
    {
      "id": "cache-console-hashed-bundles",
      "enabled": true,
      "priority": 80,
      "match": {
        "hostPatterns": [
          "console.cloud.google.com"
        ],
        "pathPatterns": [
          "/m/_/js/**",
          "/m/_/ss/**",
          "/_/js/**",
          "/_/ss/**"
        ],
        "extensionIn": [
          "js",
          "css",
          "mjs"
        ]
      },
      "policy": "CACHE_FIRST",
      "ttlDays": 30,
      "note": "Closure-/Angular-Bundles der Console, inhaltlich ueber Build-Hash abgesichert"
    },
    {
      "id": "cache-gstatic",
      "enabled": true,
      "priority": 80,
      "match": {
        "hostPatterns": [
          "www.gstatic.com",
          "ssl.gstatic.com",
          "fonts.gstatic.com"
        ]
      },
      "policy": "CACHE_FIRST",
      "ttlDays": 90
    },
    {
      "id": "cache-lh-usercontent-images",
      "enabled": true,
      "priority": 70,
      "match": {
        "hostPatterns": [
          "lh3.googleusercontent.com",
          "lh4.googleusercontent.com",
          "*.ggpht.com"
        ]
      },
      "policy": "CACHE_FIRST",
      "ttlDays": 7,
      "note": "Avatare/Screenshots; ggf. auf 3 Tage reduzieren"
    },
    {
      "id": "cache-icons-images",
      "enabled": true,
      "priority": 70,
      "match": {
        "extensionIn": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "svg",
          "gif",
          "ico",
          "woff2",
          "woff",
          "ttf"
        ]
      },
      "policy": "CACHE_FIRST",
      "ttlDays": 7
    },
    {
      "id": "swr-console-html-fragments",
      "enabled": false,
      "priority": 40,
      "match": {
        "hostPatterns": [
          "console.cloud.google.com"
        ],
        "pathPatterns": [
          "/m/_/ConsoleUi/**"
        ]
      },
      "policy": "SWR",
      "ttlDays": 1,
      "note": "Experimentell: UI-Metadaten. Erst aktivieren, wenn klar ist, dass sie nicht personalisiert/project-scoped sind."
    },
    {
      "id": "optional-local-fonts",
      "enabled": false,
      "priority": 60,
      "match": {
        "hostPatterns": [
          "fonts.googleapis.com"
        ]
      },
      "policy": "LOCAL_OVERRIDE",
      "local": "assets/shell/fonts/",
      "note": "Ersetzt Webfont-CSS durch lokal gebuendelte Fonts; veraendert Optik, daher default AUS"
    }
  ],
  "prefetch": {
    "enabled": true,
    "learnTopN": 40,
    "maxPrefetchBytes": 52428800,
    "constraints": {
      "unmetered": true,
      "batteryNotLow": true
    },
    "seedUrls": [
      "https://console.cloud.google.com/home/dashboard",
      "https://console.cloud.google.com/compute/instances",
      "https://console.cloud.google.com/logs",
      "https://console.cloud.google.com/billing"
    ],
    "$comment": "seedUrls werden nur mit vorhandener Session und nie als authentifizierter API-Call gecacht (siehe ADR-002, Abschnitt 7)."
  },
  "metrics": {
    "logEveryRequest": true,
    "persistAggregateDays": 30
  }
}
