diff --git a/.github/workflows/android-console-pocket.yml b/.github/workflows/android-console-pocket.yml
new file mode 100644
index 0000000..40c3a3f
--- /dev/null
+++ b/.github/workflows/android-console-pocket.yml
@@ -0,0 +1,66 @@
+name: Console Pocket (Android)
+
+# Läuft nur bei Änderungen im eigenen Projektordner - das Python-Projekt im Repo-Root
+# (qoder-creator) bleibt von diesem Workflow unberührt.
+on:
+  push:
+    paths:
+      - 'gcloud-console-app/**'
+      - '.github/workflows/android-console-pocket.yml'
+  pull_request:
+    paths:
+      - 'gcloud-console-app/**'
+      - '.github/workflows/android-console-pocket.yml'
+  workflow_dispatch:
+
+jobs:
+  build:
+    name: Tests, Lint, APK
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+
+    defaults:
+      run:
+        working-directory: gcloud-console-app
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Gradle 9.6 bereitstellen
+        uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: '9.6'
+          cache-read-only: false
+
+      # Der Wrapper-JAR liegt bewusst nicht im Repo (Binary); er wird hier erzeugt.
+      - name: Gradle-Wrapper erzeugen
+        run: gradle wrapper --gradle-version 9.6
+
+      - name: Unit-Tests (Cache-Pipeline, Regeln, UA, Navigation)
+        run: ./gradlew :app:testDebugUnitTest --stacktrace
+
+      - name: Lint
+        run: ./gradlew :app:lintDebug
+
+      - name: Debug-APK
+        run: ./gradlew :app:assembleDebug
+
+      - name: Release-APK (mit Debug-Signatur, für Sideload)
+        run: ./gradlew :app:assembleRelease
+
+      - name: Artefakte hochladen
+        uses: actions/upload-artifact@v4
+        with:
+          name: console-pocket-apks
+          path: |
+            gcloud-console-app/app/build/outputs/apk/debug/*.apk
+            gcloud-console-app/app/build/outputs/apk/release/*.apk
+            gcloud-console-app/app/build/reports/tests/testDebugUnitTest/**
+          if-no-files-found: warn
+          retention-days: 14
